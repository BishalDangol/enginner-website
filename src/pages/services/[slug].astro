---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import SpecTable from "../../components/SpecTable.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((svc) => ({
    params: { slug: svc.id },
    props: { svc },
  }));
}

const { svc } = Astro.props;
const { Content } = await render(svc);

// Technical specs mapped per service
const serviceSpecs: Record<string, any[]> = {
  "tower-construction": [
    { parameter: "Steel Yield Strength", value: "ASTM A572 Grade 50 (345 MPa)", standard: "ASTM A572", tolerance: "± 2%" },
    { parameter: "Galvanization Coating", value: "86 µm minimum (610 g/m²)", standard: "ASTM A123 / ISO 1461", tolerance: "Min 86 µm" },
    { parameter: "Fastener Grade", value: "High-Strength ASTM A325 Type 1", standard: "ASTM A325 / F3125", tolerance: "Torque 100% Verified" },
    { parameter: "Max Verticality Tolerance", value: "Height / 1000 (< 0.1% slant)", standard: "TIA-222-H Annex J", tolerance: "Theodolite Verified" },
    { parameter: "Wind Speed Resistance", value: "160 to 210 km/h gusts", standard: "IS 875 (Part 3) / TIA", tolerance: "Class IV / V" },
  ],
  "civil-foundations": [
    { parameter: "Concrete Compressive Strength", value: "M25 / M30 (25-30 N/mm²)", standard: "IS 456 / ACI 318", tolerance: "28-day cylinder crush" },
    { parameter: "Rock Anchor Post-Tension", value: "32mm Dywidag Threadbar", standard: "PTI DC35.1", tolerance: "Proof load 1.33x design" },
    { parameter: "Soil Safe Bearing Capacity", value: "SPT 'N' Value Verified", standard: "ASTM D1586", tolerance: "Borehole report logged" },
    { parameter: "Grout Non-Shrink Strength", value: "60 MPa @ 28 Days", standard: "ASTM C1107", tolerance: "Zero shrinkage" },
  ],
  "structural-analysis": [
    { parameter: "Analysis Engine", value: "3D Finite Element (FEA) Matrix", standard: "TIA-222-H / ANSI/TIA", tolerance: "Nonlinear P-Delta" },
    { parameter: "Antenna Effective Projected Area", value: "Up to 18 m² calculated", standard: "TIA-222-H § 2.6.9", tolerance: "EPA certified" },
    { parameter: "Allowable Stress Ratio", value: "Maximum 1.00 (100% capacity)", standard: "AISC 360-16", tolerance: "0.05 safety margin" },
    { parameter: "Max Allowable Twist / Sway", value: "< 0.5 degrees at 10-yr wind", standard: "EIA/TIA microwave criteria", tolerance: "No beam squint" },
  ],
  "fiber-backbone": [
    { parameter: "Fiber Attenuation Rate", value: "< 0.20 dB/km @ 1550 nm", standard: "ITU-T G.652.D / G.657", tolerance: "± 0.02 dB" },
    { parameter: "Optical Splice Loss", value: "< 0.03 dB per core average", standard: "Telcordia GR-765", tolerance: "Bi-directional OTDR" },
    { parameter: "ADSS Tensile Span", value: "Up to 350 meters un-guyed", standard: "IEEE 1222", tolerance: "Sag < 1.5% max" },
    { parameter: "Micro-Duct Pressure Test", value: "12 Bar pneumatic hold for 30m", standard: "EN 50411", tolerance: "No pressure leak" },
  ],
  "microwave-backhaul": [
    { parameter: "Dish Return Loss (VSWR)", value: "VSWR < 1.15 across sub-band", standard: "ETSI EN 302 217", tolerance: "Swept 2-18 GHz" },
    { parameter: "Receive Signal Level (RSL)", value: "Within ± 1 dB of path model", standard: "Pathloss 5.1 calculation", tolerance: "Optical sight checked" },
    { parameter: "Link Availability Target", value: "99.999% (Five Nines)", standard: "ITU-R P.530-17", tolerance: "Vigants-Barnett model" },
    { parameter: "Cross-Polar Discrimination", value: "> 30 dB isolation", standard: "FCC Part 101", tolerance: "Dual polarization" },
  ],
  "maintenance-noc": [
    { parameter: "Ground Earth Resistance", value: "< 5.0 Ohms (Typical < 2.0 Ω)", standard: "IEEE 81 / ITU-T K.27", tolerance: "3-point fall-of-potential" },
    { parameter: "Fastener Torque Audit", value: "100% structural bolts tested", standard: "RCSC Specification", tolerance: "Torque seal tagged" },
    { parameter: "Aviation Strobe Intensity", value: "2,000 cd Night / 20,000 cd Day", standard: "ICAO Annex 14 Type B", tolerance: "Photocell calibrated" },
    { parameter: "Emergency Dispatch SLA", value: "Under 4 hours to site", standard: "Apex Master Service SLA", tolerance: "24/7 dedicated crew" },
  ],
};

const specs = serviceSpecs[svc.id] || [
  { parameter: "Standard Compliance", value: "TIA-222-H / ISO 9001", standard: "International", tolerance: "Certified" },
];
---

<BaseLayout
  title={`${svc.data.title} // Apex Tower Engineering`}
  description={svc.data.summary}
>
  <div class="service-detail-container">
    <!-- Breadcrumb & Sheet Tag -->
    <nav class="breadcrumb-nav label" aria-label="Breadcrumb">
      <a href="/services">SERVICES</a>
      <span aria-hidden="true">//</span>
      <span class="active-crumb">{svc.data.title.toUpperCase()}</span>
    </nav>

    <header class="detail-header">
      <div class="header-tags">
        <span class="label tag-sheet">SHEET [{String(svc.data.order).padStart(2, '0')}]</span>
        <span class="label tag-iso">QA: ISO 9001:2015</span>
      </div>
      <h1 class="detail-title">{svc.data.title}</h1>
      <p class="detail-lead">{svc.data.summary}</p>
    </header>

    <!-- Content Split: Technical Text & Spec Table -->
    <div class="detail-body-grid">
      <div class="prose-content">
        <Content />

        <div class="procurement-callout">
          <span class="label callout-tag">PROCUREMENT &amp; TENDER TERMS</span>
          <p class="callout-desc">
            All scopes include third-party certified mill test reports, concrete batch crushing certificates, and stamped PE structural calculations.
          </p>
          <Button href="/contact" variant="primary">
            Request Quote for This Scope
          </Button>
        </div>
      </div>

      <aside class="detail-sidebar">
        <!-- Spec Table -->
        <div class="sidebar-box">
          <SpecTable
            caption={`Engineering Limits: ${svc.data.title}`}
            rows={specs}
          />
        </div>

        <div class="sidebar-box emergency-box">
          <span class="label">NOC EMERGENCY DISPATCH</span>
          <p class="emergency-text">
            For critical transmission outages or storm-damaged towers requiring rapid field response, contact the emergency desk.
          </p>
          <a href="tel:+97714567890" class="emergency-phone data">+977 1 456-7890</a>
          <span class="label dispatch-sla">SLA: 4-HOUR ON-SITE DEPLOYMENT</span>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .service-detail-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-5) var(--gutter) var(--space-9) var(--gutter);
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--ink-500);
  }

  .breadcrumb-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .breadcrumb-nav a:hover {
    color: var(--color-text-accent);
    text-decoration: underline;
  }

  .active-crumb {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .detail-header {
    border-bottom: var(--border-hairline);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .header-tags {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .tag-sheet {
    color: var(--color-action-primary);
    font-weight: 700;
  }

  .tag-iso {
    color: var(--ink-500);
  }

  .detail-title {
    font-size: var(--font-size-h1);
    margin: 0 0 var(--space-3) 0;
  }

  .detail-lead {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 75ch;
    margin: 0;
  }

  .detail-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }

  @media (min-width: 1024px) {
    .detail-body-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .prose-content :global(h2) {
    font-size: var(--font-size-h2);
    margin: var(--space-6) 0 var(--space-3) 0;
    color: var(--color-text-primary);
  }

  .prose-content :global(h3) {
    font-size: 1.125rem;
    margin: var(--space-4) 0 var(--space-2) 0;
    color: var(--color-text-primary);
  }

  .prose-content :global(p) {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .prose-content :global(ul), .prose-content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-5);
    color: var(--color-text-secondary);
  }

  .prose-content :global(li) {
    margin-bottom: var(--space-2);
    line-height: 1.5;
  }

  .procurement-callout {
    background-color: var(--color-surface-raised);
    border: var(--border-strong);
    box-shadow: var(--shadow-hard);
    padding: var(--space-5);
    margin-top: var(--space-6);
  }

  .callout-tag {
    color: var(--color-action-primary);
    margin-bottom: var(--space-2);
    display: block;
  }

  .callout-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.45;
  }

  .detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .sidebar-box {
    background-color: var(--color-surface-raised);
    border: var(--border-strong);
    padding: var(--space-4);
  }

  .emergency-box {
    background-color: var(--color-surface-night);
    color: var(--color-text-on-night);
    border-left: 4px solid var(--color-status-operational);
  }

  .emergency-text {
    font-size: 0.875rem;
    opacity: 0.85;
    margin: var(--space-2) 0;
    line-height: 1.4;
  }

  .emergency-phone {
    font-size: 1.375rem;
    color: var(--color-graphic-accent);
    text-decoration: none;
    display: block;
    margin-bottom: var(--space-2);
  }

  .dispatch-sla {
    color: var(--color-text-on-night);
    opacity: 0.6;
    font-size: 0.6875rem;
  }
</style>
